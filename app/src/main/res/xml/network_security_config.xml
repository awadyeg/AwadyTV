<?xml version="1.0" encoding="utf-8"?>
<!-- Xtream Codes panels are very often served over plain HTTP on custom ports,
     so cleartext must be allowed for user-supplied servers. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
